@model WebBanDoAnOnline.Models.DanhMuc

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Thêm danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-circle-plus text-warning me-2"></i>
        Thêm danh mục mới
    </h4>
    @Html.ActionLink("Quay lại", "Index", null,
        new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">
                <i class="fa-solid fa-circle-exclamation me-1"></i>
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Create", "AdminDanhMuc", FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            <div class="row g-4">

                <div class="col-md-7">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Tên danh mục</label>
                        @Html.TextBoxFor(x => x.TenDM, new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: Món chính, Đồ uống..."
                        })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Ảnh danh mục</label>
                        <input type="file"
                               name="imageFile"
                               id="imageFile"
                               accept="image/*"
                               class="form-control"
                               onchange="previewImage(event)" />
                        <div class="form-text">Định dạng JPG, PNG. Nên dùng ảnh vuông để hiển thị đẹp.</div>
                    </div>

                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold small">Xem trước</label>
                    <div class="border rounded-3 d-flex align-items-center justify-content-center"
                         style="height:200px; background-color:#f8f9fa; overflow:hidden;">
                        <img id="previewImg"
                             src="https://via.placeholder.com/200x200?text=Chua+co+anh"
                             style="max-width:100%; max-height:100%; object-fit:cover;" />
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu danh mục
                </button>
                @Html.ActionLink("Hủy", "Index", null,
                    new { @class = "btn btn-light px-4" })
            </div>
        }

    </div>
</div>

@section scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById('previewImg').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}