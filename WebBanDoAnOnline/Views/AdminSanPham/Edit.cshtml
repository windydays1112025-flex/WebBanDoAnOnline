@model WebBanDoAnOnline.Models.SanPham

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Chỉnh sửa sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-pen-to-square text-warning me-2"></i>
        Chỉnh sửa sản phẩm
    </h4>
    @Html.ActionLink("Quay lại", "Index", null,
        new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">
                <i class="fa-solid fa-circle-exclamation me-1"></i>
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Edit", "AdminSanPham", FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(x => x.MaSP)

            <div class="row g-4">

                <div class="col-md-7">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Tên sản phẩm</label>
                        @Html.TextBoxFor(x => x.TenSP, new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: Phở bò, Bánh mì..."
                        })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Danh mục</label>
                            @Html.DropDownList("MaDM", null, "-- Chọn danh mục --",
                                new { @class = "form-select" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Giá (đ)</label>
                            @Html.TextBox("Gia", Model.Gia.HasValue ? Model.Gia.Value.ToString("0") : "", new
                            {
                                @class = "form-control",
                                type = "number"
                            })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Mô tả</label>
                        @Html.TextAreaFor(x => x.MoTa, new
                        {
                            @class = "form-control",
                            rows = 4
                        })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Trạng thái</label>
                        @Html.DropDownListFor(x => x.TrangThai,
                            new SelectList(new[]
                            {
                                "Còn hàng",
                                "Hết hàng",
                                "Tạm ngưng"
                            }, Model.TrangThai),
                            new { @class = "form-select" })
                    </div>

                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold small">Ảnh sản phẩm</label>
                    <div class="border rounded-3 d-flex align-items-center justify-content-center mb-2"
                         style="height:220px; background-color:#f8f9fa; overflow:hidden;">
                        <img id="previewImg"
                             src="@Url.Content(Model.Anh ?? "~/img/no-image.png")"
                             style="max-width:100%; max-height:100%; object-fit:cover;" />
                    </div>
                    <input type="file"
                           name="uploadFile"
                           accept="image/*"
                           class="form-control"
                           onchange="previewImage(event)" />
                    <div class="form-text">Bỏ trống nếu muốn giữ ảnh hiện tại.</div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi
                </button>
                @Html.ActionLink("Hủy", "Index", null,
                    new { @class = "btn btn-light px-4" })
            </div>
        }

    </div>
</div>

@section scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById('previewImg').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}