@model WebBanDoAnOnline.Models.SanPham
@{
    ViewBag.Title = Model.TenSP;
}

<div class="container mt-5">
    <div class="row">

        <div class="col-md-5">
            <img src="@Url.Content(Model.Anh)"
                 alt="@Model.TenSP"
                 class="img-fluid rounded" />
        </div>

        <div class="col-md-7">

            <h2>@Model.TenSP</h2>

            <div class="mb-3">
                <span style="color:gold;font-size:20px;">★</span>
                <strong>@ViewBag.DiemTB.ToString("0.0")</strong>
                <span class="text-muted">(@ViewBag.SoLuongDanhGia đánh giá)</span>
            </div>

            <hr />

            <h4 class="text-danger">
                @(Model.Gia.HasValue ? Model.Gia.Value.ToString("N0") : "0") đ
            </h4>

            <p>@Model.MoTa</p>

            <p>
                <strong>Trạng thái:</strong>
                @Model.TrangThai
            </p>

            <div class="mt-3">
                <a href="@Url.Action("Index","Menu")" class="btn btn-secondary">
                    Quay lại
                </a>

                @if (Session["TaiKhoan"] != null)
                {
                    <a href="#" class="btn btn-success" id="btnThemGio">
                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ hàng
                    </a>
                }
                else
                {
                    <a href="#" class="btn btn-success" id="btnThemGio"
                       data-chua-dangnhap="true">
                        <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ hàng
                    </a>
                }
            </div>

        </div>

    </div>
</div>

<hr class="mt-5" />

<div class="container">
    <h3>Đánh giá khách hàng</h3>

    @if (ViewBag.DanhGia != null && ViewBag.DanhGia.Count > 0)
    {
        foreach (WebBanDoAnOnline.Models.DanhGia dg in ViewBag.DanhGia)
        {
            <div class="card mb-3">
                <div class="card-body">

                    <h5>@dg.TaiKhoan.HoTen</h5>

                    <div class="mb-2">
                        @for (int i = 0; i < dg.SoSao; i++)
                        {
                            <span style="color:gold;">★</span>
                        }
                        @for (int i = dg.SoSao; i < 5; i++)
                        {
                            <span style="color:#ccc;">★</span>
                        }
                    </div>

                    <p>@dg.BinhLuan</p>

                    <small class="text-muted">
                        @(dg.Create_at != null
                            ? dg.Create_at.Value.ToString("dd/MM/yyyy HH:mm")
                            : "")
                    </small>

                    @if (!string.IsNullOrEmpty(dg.PhanHoi))
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Phản hồi từ cửa hàng:</strong>
                            <br />
                            @dg.PhanHoi
                        </div>
                    }

                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            Chưa có đánh giá nào cho sản phẩm này.
        </div>
    }
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('#btnThemGio').on('click', function (e) {
            e.preventDefault();

            // Chưa đăng nhập
            if ($(this).data('chua-dangnhap')) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Chưa đăng nhập',
                    text: 'Bạn cần đăng nhập để thêm món vào giỏ hàng!',
                    showCancelButton: true,
                    confirmButtonColor: '#f97316',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập ngay',
                    cancelButtonText: 'Để sau'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("DangNhap", "TaiKhoan")?returnUrl=@Url.Action("ChiTiet", "Menu", new { id = Model.MaSP })';
                    }
                });
                return;
            }

            // Đã đăng nhập → thông báo rồi chuyển hướng
            Swal.fire({
                icon: 'success',
                title: 'Thành công!',
                text: 'Đang thêm món ăn vào giỏ hàng...',
                timer: 1000,
                showConfirmButton: false
            }).then(function () {
                window.location.href = '@Url.Action("ThemGioHang", "GioHang", new { id = Model.MaSP })';
            });
        });
    </script>
}