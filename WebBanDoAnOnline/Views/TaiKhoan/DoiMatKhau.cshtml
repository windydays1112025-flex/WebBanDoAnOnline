@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@using (Html.BeginForm())
{
    <div class="mb-3">
        <label>Mật khẩu cũ</label>
        <input type="password"
               name="MatKhauCu"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mật khẩu mới</label>
        <input type="password"
               name="MatKhauMoi"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Xác nhận mật khẩu</label>
        <input type="password"
               name="XacNhanMatKhau"
               class="form-control" />
    </div>

    <button class="btn btn-warning">
        Đổi mật khẩu
    </button>
}