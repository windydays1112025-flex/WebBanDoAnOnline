<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị Ngon Food</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <style>
        :root {
            --sidebar-width: 240px;
            --primary: #f97316;
            --primary-dark: #ea6c0a;
            --sidebar-bg: #1e1e2d;
            --sidebar-text: #a0a3b1;
            --sidebar-active: #f97316;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Sidebar */
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow-y: auto;
        }

        .sidebar-logo {
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .sidebar-logo a {
                text-decoration: none;
                font-size: 22px;
                font-weight: 700;
                color: #fff;
            }

            .sidebar-logo span {
                color: var(--primary);
            }

        .sidebar-menu {
            padding: 16px 0;
            flex: 1;
        }

        .menu-label {
            padding: 8px 20px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.3);
            font-weight: 600;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }

            .sidebar-menu a:hover {
                color: #fff;
                background-color: rgba(255,255,255,0.06);
            }

            .sidebar-menu a.active {
                color: #fff;
                background-color: rgba(249,115,22,0.15);
                border-left-color: var(--primary);
            }

            .sidebar-menu a i {
                width: 18px;
                text-align: center;
                font-size: 15px;
            }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

            .sidebar-footer .user-info {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 12px;
            }

            .sidebar-footer img {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                object-fit: cover;
            }

            .sidebar-footer .user-name {
                font-size: 13px;
                font-weight: 600;
                color: #fff;
            }

            .sidebar-footer .user-role {
                font-size: 11px;
                color: var(--sidebar-text);
            }

            .sidebar-footer a.logout {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #ff6b6b;
                font-size: 13px;
                text-decoration: none;
                padding: 8px 0;
                transition: opacity 0.2s;
            }

                .sidebar-footer a.logout:hover {
                    opacity: 0.8;
                }

        /* Main content */
        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Topbar */
        .admin-topbar {
            background-color: #fff;
            padding: 14px 24px;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .topbar-title {
            font-size: 18px;
            font-weight: 600;
            color: #1e1e2d;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* Content area */
        .admin-content {
            padding: 24px;
            flex: 1;
        }

        /* TempData alerts */
        .alert-fixed {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            animation: fadeIn 0.3s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    @{
        var adminUser = Session["TaiKhoan"] as WebBanDoAnOnline.Models.TaiKhoan;
        var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    }

    <!-- SIDEBAR -->
    <div class="admin-sidebar">

        <div class="sidebar-logo">
            <a href="@Url.Action("Index", "Admin")">
                <span>Ngon</span> Food
                <div style="font-size:10px; color:rgba(255,255,255,0.4); font-weight:400; margin-top:2px">
                    Trang quản trị
                </div>
            </a>
        </div>

        <div class="sidebar-menu">

            <div class="menu-label">Tổng quan</div>
            <a href="@Url.Action("Index", "Admin")"
               class="@(currentController == "Admin" ? "active" : "")">
                <i class="fa-solid fa-chart-line"></i> Dashboard
            </a>

            <div class="menu-label">Quản lý</div>
            <a href="@Url.Action("Index", "AdminDonHang")"
               class="@(currentController == "AdminDonHang" ? "active" : "")">
                <i class="fa-solid fa-receipt"></i> Đơn hàng
            </a>

            <a href="@Url.Action("Index", "AdminSanPham")"
               class="@(currentController == "AdminSanPham" ? "active" : "")">
                <i class="fa-solid fa-bowl-food"></i> Sản phẩm
            </a>

            <a href="@Url.Action("Index", "AdminDanhMuc")"
               class="@(currentController == "AdminDanhMuc" ? "active" : "")">
                <i class="fa-solid fa-list"></i> Danh mục
            </a>

            <a href="@Url.Action("Index", "AdminTaiKhoan")"
               class="@(currentController == "AdminTaiKhoan" ? "active" : "")">
                <i class="fa-solid fa-users"></i> Tài khoản
            </a>

            <a href="@Url.Action("Index", "AdminDanhGia")"
               class="@(currentController == "AdminDanhGia" ? "active" : "")">
                <i class="fa-solid fa-star"></i> Đánh giá
            </a>

            

            <div class="menu-label">Hệ thống</div>
            <a href="@Url.Action("Index", "Home")" target="_blank">
                <i class="fa-solid fa-globe"></i> Xem trang web
            </a>

        </div>

        <div class="sidebar-footer">
            @if (adminUser != null)
            {
                <div class="user-info">
                    <img src="@Url.Content("~/img/avatar.png")" alt="Avatar" />
                    <div>
                        <div class="user-name">@adminUser.HoTen</div>
                        <div class="user-role">@adminUser.VaiTro</div>
                    </div>
                </div>
            }
            <a href="@Url.Action("DangXuat", "TaiKhoan")" class="logout">
                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
            </a>
        </div>

    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main">

        <!-- Topbar -->
        <div class="admin-topbar">
            <div class="topbar-title">
                <i class="fa-solid fa-gauge me-2 text-warning"></i>
                @ViewBag.Title
            </div>
            <div class="topbar-right">
                @if (adminUser != null)
                {
                    <span class="text-muted small">
                        Xin chào, <strong>@adminUser.HoTen</strong>
                    </span>
                }
            </div>
        </div>

        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible alert-fixed" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible alert-fixed" role="alert">
                <i class="fa-solid fa-circle-xmark me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Page content -->
        <div class="admin-content">
            @RenderBody()
        </div>

    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @* Tự động ẩn alert sau 3 giây *@
    <script>
    setTimeout(function () {
        $('.alert-fixed').fadeOut('slow');
    }, 3000);
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>