@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Dashboard";

    decimal tongDoanhThu = (decimal)ViewBag.TongDoanhThu;
    int tongDonHang = (int)ViewBag.TongDonHang;
    int donChoXacNhan = (int)ViewBag.DonChoXacNhan;
    int donDangGiao = (int)ViewBag.DonDangGiao;
    int tongSanPham = (int)ViewBag.TongSanPham;
    int tongKhachHang = (int)ViewBag.TongKhachHang;
}

@* --- STAT CARDS --- *@
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background-color:#fff3e0">
                    <i class="fa-solid fa-money-bill-wave fa-lg" style="color:#f97316"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng doanh thu</div>
                    <div class="fw-bold fs-5">@tongDoanhThu.ToString("N0")đ</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background-color:#e3f2fd">
                    <i class="fa-solid fa-receipt fa-lg" style="color:#1976d2"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng đơn hàng</div>
                    <div class="fw-bold fs-5">@tongDonHang</div>
                    <div style="font-size:11px">
                        <span class="text-warning">@donChoXacNhan chờ xác nhận</span>
                        · <span class="text-info">@donDangGiao đang giao</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background-color:#e8f5e9">
                    <i class="fa-solid fa-bowl-food fa-lg" style="color:#388e3c"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng sản phẩm</div>
                    <div class="fw-bold fs-5">@tongSanPham</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3" style="background-color:#fce4ec">
                    <i class="fa-solid fa-users fa-lg" style="color:#c2185b"></i>
                </div>
                <div>
                    <div class="text-muted small">Khách hàng</div>
                    <div class="fw-bold fs-5">@tongKhachHang</div>
                </div>
            </div>
        </div>
    </div>

</div>

@* --- BẢNG + SẢN PHẨM BÁN CHẠY --- *@
<div class="row g-3">

    @* Đơn hàng mới nhất *@
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <strong>Đơn hàng mới nhất</strong>
                <a href="@Url.Action("Index","AdminDonHang")"
                   class="btn btn-sm btn-outline-warning">
                    Xem tất cả
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dh in ViewBag.DonHangMoiNhat)
                        {
                            <tr>
                                <td><strong>#@dh.MaDH</strong></td>
                                <td>
                                    @if (dh.TaiKhoan != null)
                                    {
                                        @dh.TaiKhoan.HoTen
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td class="text-warning fw-bold">
                                    @(dh.TongTien != null ? ((decimal)dh.TongTien).ToString("N0") + "đ" : "0đ")
                                </td>
                                <td>
                                    @{
                                        string badgeClass = "secondary";
                                        if (dh.TrangThai == "Chờ xác nhận")
                                        {
                                            badgeClass = "warning text-dark";
                                        }
                                        else if (dh.TrangThai == "Đã xác nhận")
                                        {
                                            badgeClass = "primary";
                                        }
                                        else if (dh.TrangThai == "Đang giao")
                                        {
                                            badgeClass = "info text-dark";
                                        }
                                        else if (dh.TrangThai == "Đã nhận hàng")
                                        {
                                            badgeClass = "success";
                                        }
                                        else if (dh.TrangThai == "Đã hủy")
                                        {
                                            badgeClass = "danger";
                                        }
                                    }
                                    <span class="badge bg-@badgeClass">@dh.TrangThai</span>
                                </td>
                                <td class="text-muted small">
                                    @(dh.Create_at != null
                                        ? ((DateTime)dh.Create_at).ToString("dd/MM/yyyy HH:mm")
                                        : "")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Sản phẩm bán chạy *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <strong>Sản phẩm bán chạy</strong>
            </div>
            <div class="card-body">
                @foreach (var item in (List<WebBanDoAnOnline.Controllers.SanPhamBanChayViewModel>)ViewBag.SanPhamBanChay)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@Url.Content(item.SanPham.Anh)"
                             style="width:48px;height:48px;object-fit:cover;border-radius:8px"
                             onerror="this.src='/Content/images/no-image.png'" />
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="small fw-bold text-truncate">@item.SanPham.TenSP</div>
                            <div class="text-muted" style="font-size:11px">
                                Đã bán: <strong>@item.TongSoLuong</strong>
                            </div>
                        </div>
                        <div class="text-warning fw-bold small text-nowrap">
                            @item.SanPham.Gia.Value.ToString("N0")đ
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>
